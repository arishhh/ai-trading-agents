# --- API KEY (Required) ---
GROQ_API_KEY=               # Get from console.groq.com

# --- Convex Backend (Required) ---
CONVEX_URL=                 # Run 'npx convex dev' to get this URL

# --- Agent Settings ---
PAPER_MODE=true             # Set to true for paper trading (Kraken CLI)
LOOP_INTERVAL_MS=300000     # 5 minutes = 300000ms

# --- Optional ---
NODE_ENV=development
