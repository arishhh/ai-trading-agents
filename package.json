{
  "name": "krakenai-trader",
  "version": "1.0.0",
  "description": "Autonomous AI crypto trading agent for Kraken CLI + Convex",
  "main": "agent/loop.ts",
  "scripts": {
    "agent": "tsx agent/loop.ts",
    "setup:kraken": "curl --proto '=https' --tlsv1.2 -LsSf https://github.com/krakenfx/kraken-cli/releases/latest/download/kraken-cli-installer.sh | sh",
    "build": "npm run setup:kraken && npx convex deploy"
  },
  "dependencies": {
    "groq-sdk": "^0.13.0",
    "convex": "^1.11.0",
    "tsx": "^4.10.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.12.12"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
