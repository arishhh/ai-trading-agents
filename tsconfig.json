{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDirs": [".", "./agent", "./convex"],
    "declaration": true,
    "sourceMap": true,
    "lib": ["ESNext", "DOM"]
  },
  "include": ["agent/**/*.ts", "convex/**/*.ts"],
  "exclude": ["node_modules", "dashboard"]
}
